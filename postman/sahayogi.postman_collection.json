        {
          "name": "Forgot password 1 - email me a code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{volunteer_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/request-password-reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "request-password-reset"
              ]
            },
            "description": "Always 200, same body for unknown emails. Code is valid 10 min. Local without Gmail: set OTP_DEV_LOG=true in supabase/functions/.env and read the code in the `supabase functions serve` terminal. Put it into the environment variable reset_otp."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "console.log(pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password 2 - verify code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{volunteer_email}}\",\n  \"otp\": \"{{reset_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/verify-reset-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "verify-reset-otp"
              ]
            },
            "description": "Set reset_otp in the environment first. A wrong code returns 400 invalid_otp with attempts_left; the 5th wrong code is 429 otp_locked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data) pm.environment.set('reset_token', j.data.reset_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password 3 - set new password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{volunteer_email}}\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"new_password\": \"{{new_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "reset-password"
              ]
            },
            "description": "Uses reset_token from step 2 (single use, 10 min). new_password needs 10+ chars with upper, lower, digit and symbol. Sets the password of the demo user, so use the same value as DEMO_PASSWORD to keep the other requests working."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password - replay token (must be 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{volunteer_email}}\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"new_password\": \"{{new_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "reset-password"
              ]
            },
            "description": "Run right after step 3: the token is already spent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400 invalid_token', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('invalid_token'); });"
                ]
              }
            }
          ]
        }
      ]
    },
