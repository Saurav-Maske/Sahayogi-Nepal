{
  "info": {
    "name": "Sahayogi Nepal - backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders top to bottom. Select the 'Sahayogi local' environment first and paste anon_key into it (supabase status)."
  },
  "item": [
    {
      "name": "0 - Sanity",
      "item": [
        {
          "name": "Districts seeded? (expect 77 rows when unlimited)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/districts?select=id,name,province&order=id&limit=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "districts?select=id,name,province&order=id&limit=5"
              ]
            },
            "description": "Needs only the anon key. Empty array = seed did not run."
          }
        }
      ]
    },
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/admin-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "admin-login"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('200 + session', () => { pm.response.to.have.status(200); pm.expect(j.data.session.access_token).to.be.a('string'); });",
                  "if (j.data) { pm.environment.set('admin_token', j.data.session.access_token); pm.environment.set('admin_refresh', j.data.session.refresh_token); pm.environment.set('admin_user_id', j.data.profile.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Volunteer login (driver1)",
          "request": {
