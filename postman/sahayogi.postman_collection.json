    {
      "name": "3 - Volunteer application",
      "item": [
        {
          "name": "0a. Send sign-up code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.driver@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/send-signup-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "send-signup-otp"
              ]
            },
            "description": "Code goes to the email (local without Gmail: printed in the functions serve terminal when OTP_DEV_LOG=true). Put it into signup_otp. A second call within 60 s is 429 resend_too_soon."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "console.log(pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "0b. Verify sign-up code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.driver@example.com\",\n  \"otp\": \"{{signup_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/verify-signup-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "verify-signup-otp"
              ]
            },
            "description": "Stores email_verification_token (valid 30 min, single use) for step 2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data) pm.environment.set('email_verification_token', j.data.email_verification_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Get upload URLs (driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"volunteer_type\": \"driver\",\n  \"files\": [\n    {\n      \"kind\": \"citizenship\",\n      \"content_type\": \"image/jpeg\"\n    },\n    {\n      \"kind\": \"license\",\n      \"content_type\": \"image/jpeg\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/create-upload-urls",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "create-upload-urls"
