{
  "info": {
    "name": "Sahayogi Nepal - Edge API (admin-api, volunteer-api, public-api)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order: 0, 1, 2, 3, 4. Uses the variables in postman/demo.postman_environment.json (or local.postman_environment.json plus helper_token, request_id, assignment_id, lot_id). The phone in folder 0 is randomised for you. The OTP and short-delivery flows are covered by scripts/tests/matrix.mjs, not here."
  },
  "item": [
    {
      "name": "0 - Setup (run first)",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/functions/v1/admin-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "admin-login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data) { pm.environment.set('admin_token', j.data.session.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Driver login (driver1, A+B)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/functions/v1/volunteer-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "volunteer-login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{volunteer_email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data) { pm.environment.set('volunteer_token', j.data.session.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Helper login (general, A only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/functions/v1/volunteer-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "volunteer-login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"general@demo.test\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data) { pm.environment.set('helper_token', j.data.session.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit transport request (new random phone each run)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/functions/v1/submit-request",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "functions",
                "v1",
                "submit-request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"transport_request\",\n  \"requester_name\": \"Postman Test\",\n  \"requester_phone\": \"{{phone}}\",\n  \"lat\": 27.71,\n  \"lng\": 85.32,\n  \"urgency\": \"normal\",\n  \"volunteers_needed\": 1\n}"
            },
            "description": "The pre-request script sets {{phone}} to a fresh 98xxxxxxxx number, so the 5-per-phone-per-hour limit is not hit."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('phone', '98' + String(Math.floor(10000000 + Math.random() * 89999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j.data) { pm.environment.set('request_id', j.data.request_id); pm.environment.set('public_ref', j.data.public_ref); pm.environment.set('tracking_token', j.data.tracking_token); }"
                ]
              }
            }
          ]
        }
      ],
      "description": "Logs in the three roles and creates one request to work on."
    },
