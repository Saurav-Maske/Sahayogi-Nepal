# Edge Function secrets for the HOSTED DEMO project (sahayogi-demo).
# Copy to supabase/functions/.env.demo (git-ignored by the .env.* rule) and fill in.
# Applied by scripts/demo_deploy.sh:  supabase secrets set --env-file supabase/functions/.env.demo --project-ref <ref>
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase. Do NOT list them here.

# Where the web set-password page is hosted. Must ALSO be in Auth -> URL Configuration -> Redirect URLs.
SET_PASSWORD_URL=https://REPLACE-ME.example.com/set-password/
# Browser origin of the admin web and set-password page. Not "*" on the demo.
ALLOWED_ORIGIN=https://REPLACE-ME.example.com

# Routing (get-route). Public Valhalla instance or your own.
VALHALLA_URL=

# Email OTP + invites via Resend. Also set Auth -> SMTP Settings (host smtp.resend.com, port 465, user "resend", password = the API key),
# the default Supabase sender allows only a couple of mails per hour.
RESEND_API_KEY=
# Address on a domain verified in Resend, e.g. no-reply@yourdomain.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sahayogi Nepal
# openssl rand -hex 32
OTP_PEPPER=

# Push (send-push). The SAME PUSH_WEBHOOK_SECRET goes into the database vault as 'push_secret' (scripts/demo_vault_secrets.sql).
# openssl rand -hex 32
PUSH_WEBHOOK_SECRET=
# One line of JSON, or base64 of the file. Leave empty ONLY if you accept that real FCM delivery stays untested.
FCM_SERVICE_ACCOUNT=

# Deliberately NOT set on the hosted project: OTP_DEV_LOG, PUSH_DRY_RUN.
