# Edge Function secrets. Copy to supabase/functions/.env (git-ignored).
# Local:   `npx supabase functions serve` loads this file automatically.
# Hosted:  npx supabase secrets set --env-file supabase/functions/.env
# NOTE: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.
#       Do NOT put them here (names starting with SUPABASE_ are reserved and will be rejected).

# Where the web set-password page lives. MUST also be in Auth -> URL Configuration -> Redirect URLs.
SET_PASSWORD_URL=http://localhost:5173/set-password/


VALHALLA_URL=
# Browser origin allowed to call the functions (admin web + set-password page). Use "*" only in dev.
ALLOWED_ORIGIN=*

