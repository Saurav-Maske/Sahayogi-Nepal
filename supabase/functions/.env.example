# Copy to .env (never commit). Use a SEPARATE Supabase project for demo.
# Used by scripts/*.mjs and by your local shell. Run scripts with:  node --env-file=.env scripts/seed_users.mjs
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
# SERVER ONLY: scripts + Edge Functions. Never put in Flutter or admin web.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Map provider key (restrict by app signature / bundle ID if Google)
MAPS_API_KEY=

# --- Demo seeding (scripts/seed_users.mjs) ---
# Leave empty to auto-generate a random strong password (printed once).
# Must be >= 10 chars with upper, lower, digit and symbol (matches the Auth password policy).
DEMO_PASSWORD=
# Required to run the seed against a non-local project (safety guard)
ALLOW_DEMO_SEED=

# --- Local Gmail SMTP (only if you enable [auth.email.smtp] in config.toml) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
VALHALLA_URL=