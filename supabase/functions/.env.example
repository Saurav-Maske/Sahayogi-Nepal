# Edge Function secrets. Copy to supabase/functions/.env (git-ignored).
# Local:   `npx supabase functions serve` loads this file automatically.
# Hosted:  npx supabase secrets set --env-file supabase/functions/.env
# NOTE: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.
#       Do NOT put them here (names starting with SUPABASE_ are reserved and will be rejected).

# Where the web set-password page lives. MUST also be in Auth -> URL Configuration -> Redirect URLs.
SET_PASSWORD_URL=http://localhost:5173/set-password/


# --- Email OTP (volunteer sign-up + forgot password) ---
# Gmail account that sends the codes. Use an App Password (Google Account -> Security -> 2-Step Verification -> App passwords), not the normal password.
# The same two names are read by config.toml for Supabase's own invite emails, so keep the values identical in the root .env.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional. Display name on the OTP email, and SMTP host/port (defaults: Sahayogi Nepal, smtp.gmail.com, 465).
MAIL_FROM_NAME=Sahayogi Nepal
# Long random string used to hash OTP codes and tokens (e.g. `openssl rand -hex 32`). If empty, the service-role key is used.
OTP_PEPPER=
# LOCAL ONLY. When GMAIL_* is empty, print the code in the `functions serve` terminal instead of emailing it. Never set on the hosted project.
OTP_DEV_LOG=true

VALHALLA_URL=

# --- Push notifications (send-push) ---
# Shared secret the database sends in the x-push-secret header. Generate with `openssl rand -hex 32`.
# The SAME value must be stored in the database vault as 'push_secret' (see migration 20261122000009_push_outbox.sql).
PUSH_WEBHOOK_SECRET=
# Firebase service-account JSON (Firebase console -> Project settings -> Service accounts -> Generate new private key),
# either as one line of JSON or base64 of the file (`base64 -w0 key.json`; on macOS `base64 -i key.json`).
FCM_SERVICE_ACCOUNT=
# LOCAL ONLY. When FCM_SERVICE_ACCOUNT is empty, log "would send to N devices" instead of sending. Never set on the hosted project.
PUSH_DRY_RUN=true
# Browser origin allowed to call the functions (admin web + set-password page). Use "*" only in dev.
ALLOWED_ORIGIN=*