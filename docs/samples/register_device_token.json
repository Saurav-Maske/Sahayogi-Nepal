{
  "call": "supabase.rpc('register_device_token', { p_token, p_platform })",
  "request": {
    "p_token": "<fcm token, 20 to 4096 characters>",
    "p_platform": "android"
  },
  "response": {
    "id": "b7e1c9d2-3a4f-4b5c-8d6e-7f8091a2b3c4",
    "platform": "android"
  },
  "errors": [
    "unauthorized",
    "forbidden",
    "invalid_token",
    "invalid_platform"
  ]
}
