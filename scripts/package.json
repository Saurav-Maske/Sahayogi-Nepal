{
  "name": "sahayogi-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node --env-file=../.env seed_demo.mjs && node --env-file=../.env seed_extra.mjs",
    "reset:remote": "node --env-file=../.env reset_demo_remote.mjs",
    "test:matrix": "node --env-file=../.env tests/matrix.mjs",
